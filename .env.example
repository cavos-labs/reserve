# Copy to .env and fill in. The quote key is always required.
# A sponsor secret enables that network. Set both to serve /testnet and /mainnet.

RESERVE_QUOTE_KEY=
# RESERVE_QUOTE_KEY_FILE=/run/secrets/quote

# Testnet lane. Prefer the _FILE form in production.
RESERVE_TESTNET_SPONSOR_SECRET=
# RESERVE_TESTNET_SPONSOR_SECRET_FILE=/run/secrets/sponsor-testnet
# RESERVE_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
# RESERVE_TESTNET_TOKENS=
# RESERVE_TESTNET_CHANNEL_SECRETS=

# Mainnet lane. The wildcard is refused here.
RESERVE_MAINNET_SPONSOR_SECRET=
# RESERVE_MAINNET_SPONSOR_SECRET_FILE=/run/secrets/sponsor-mainnet
# RESERVE_MAINNET_HORIZON_URL=https://horizon.stellar.org
# RESERVE_MAINNET_TOKENS=
# RESERVE_MAINNET_CHANNEL_SECRETS=

# Shared. Without an issuer, no key is accepted and every caller is anonymous.
# RESERVE_KEY_ISSUER_PUBKEY=
# RESERVE_KEY_ISSUER_SECRET=
# RESERVE_KEY_ISSUER_SECRET_FILE=/run/secrets/issuer

# Only true behind a proxy that sets X-Forwarded-For.
RESERVE_TRUST_PROXY=false

# Legacy single-lane: used only when neither TESTNET nor MAINNET sponsor is set.
# RESERVE_NETWORK=testnet
# RESERVE_SPONSOR_SECRET=
# RESERVE_SPONSOR_SECRET_FILE=/run/secrets/sponsor
# RESERVE_TOKENS=
# RESERVE_CHANNEL_SECRETS=
